# ===== عام =====
# memory = تشغيل تجريبي بدون قاعدة بيانات (بيانات ديمو في الذاكرة)
# firestore = إنتاج مع Firebase (Firestore + Storage)
DB_ADAPTER=memory

# سر توقيع الجلسات — ضروري طويل وعشوائي في الإنتاج
JWT_SECRET=change-me-to-a-long-random-string

PORT=8080

# ===== Firebase (مطلوب فقط عند DB_ADAPTER=firestore) =====
# محتوى ملف service account JSON مشفّر base64:
#   base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT_B64=
# اسم bucket — المشاريع الجديدة بصيغة <project>.firebasestorage.app والقديمة <project>.appspot.com
# (افتراضيًا يُشتق من project_id بالصيغة القديمة، فحدده صراحة لو مشروعك جديد)
FIREBASE_STORAGE_BUCKET=

# ===== استيراد المنيو بالذكاء الاصطناعي (Google Gemini) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# لو نشرت الفرونت والباك على نطاقين مختلفين، اكتب نطاق الفرونت هنا (مفصول بفواصل)
CORS_ORIGIN=
