rules_version = '2';
// كل الوصول للبيانات يتم من الخادم فقط عبر Firebase Admin SDK.
// العميل (المتصفح) لا يتصل بـ Firestore مباشرة أبدًا — لذلك نغلق كل شيء.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
